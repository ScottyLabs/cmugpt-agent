# Local development. Production launchers set AGENT_ENV=production and the app
# refuses to start without DATABASE_URL and AGENT_SHARED_SECRET.
AGENT_ENV=development
PORT=5000

# Chat completion and automatic durable-fact extraction through OpenRouter.
OPENROUTER_API_KEY=

# CMU data tools. Use the streamable-HTTP MCP endpoint.
MCP_SERVER_URL=

# Real OpenAI key for text-embedding-3-large (3072-dimensional) memory search.
OPENAI_API_KEY=

# Local example for a Unix-socket PostgreSQL database with pgvector enabled.
DATABASE_URL=postgresql:///cmugpt_agent?host=/tmp
# Optional Postgres connection-pool tuning.
# MEMORY_DB_POOL_MIN=1
# MEMORY_DB_POOL_MAX=10

# Same random 32+ character value used by the Surface server. Never expose it
# through a VITE_* variable or browser code. Generate with: openssl rand -hex 32
AGENT_SHARED_SECRET=
