# Local environment for cmugpt-agent. Copy this file to .env, which git
# ignores. Production does not use it: Kennel injects DATABASE_URL and the
# remaining secrets come from OpenBao.

# Required. Chat, memory extraction, and chat titles all go through OpenRouter.
OPENROUTER_API_KEY=

# Required. Base URL of the CMU MCP server that publishes the maps, courses,
# eats, and guide tools. The value below is the production server.
MCP_SERVER_URL=https://api.mcp-server.scottylabs.org/mcp

# Recommended. An OpenAI key, distinct from the OpenRouter key. Used for
# text-embedding-3-large (semantic memory search) and the moderation endpoint.
# Without it, recall falls back to recency order and moderation is skipped.
OPENAI_API_KEY=

# Bearer token the Surface server sends on every request. Generate one with
# `openssl rand -hex 32`. Leave it empty locally to run unauthenticated.
AGENT_SHARED_SECRET=

# Recommended. Postgres with the pgvector extension. The value below is the
# database the README creates. Leave it empty to use the in-memory store,
# which is cleared on restart.
DATABASE_URL=postgresql:///cmugpt_agent?host=/tmp

# Optional overrides and their defaults.
# PORT=5055
# ALLOWED_ORIGINS=https://cmugpt.com
# TITLE_MODEL=qwen/qwen3.7-flash
# MEMORY_EXTRACTION_MODEL=qwen/qwen3.7-flash
# TOKEN_USAGE_DB=/tmp/cmugpt_token_usage.sqlite3
